<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <UseTestingPlatformProtocol>true</UseTestingPlatformProtocol>
    <IsTestingPlatformEnabled>true</IsTestingPlatformEnabled>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Net.Compilers.Toolset" PrivateAssets="all" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../../shared/tests/StaticNorth.Valiant.SourceGeneration.Testing/*.cs" LinkBase="Shared" />
    <ProjectReference Include="../../src/StaticNorth.Valiant.Endpoints/StaticNorth.Valiant.Endpoints.csproj" />
    <ProjectReference Include="../../src/StaticNorth.Valiant.Endpoints.AspNetCore/StaticNorth.Valiant.Endpoints.AspNetCore.csproj" />
    <ProjectReference Include="../../src/StaticNorth.Valiant.Endpoints.AspNetCore.SourceGeneration/StaticNorth.Valiant.Endpoints.AspNetCore.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/StaticNorth.Valiant.Endpoints.AspNetCore.SourceGeneration/StaticNorth.Valiant.Endpoints.AspNetCore.SourceGeneration.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../samples/StaticNorth.Valiant.Endpoints.AspNetCore.Samples/StaticNorth.Valiant.Endpoints.AspNetCore.Samples.csproj" />
    <ProjectReference Include="../StaticNorth.Valiant.Endpoints.AspNetCore.TestApp/StaticNorth.Valiant.Endpoints.AspNetCore.TestApp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
