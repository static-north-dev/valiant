<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <UseTestingPlatformProtocol>true</UseTestingPlatformProtocol>
    <IsTestingPlatformEnabled>true</IsTestingPlatformEnabled>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../../shared/tests/StaticNorth.Valiant.SourceGeneration.Testing/*.cs" LinkBase="Shared" />
    <ProjectReference Include="../../src/StaticNorth.Valiant.Settings.AspNetCore/StaticNorth.Valiant.Settings.AspNetCore.csproj" />
    <ProjectReference Include="../../src/StaticNorth.Valiant.Settings/StaticNorth.Valiant.Settings.csproj" />
    <ProjectReference Include="../../src/StaticNorth.Valiant.Settings.Validation/StaticNorth.Valiant.Settings.Validation.csproj" />
    <ProjectReference Include="../../src/StaticNorth.Valiant.Settings.SourceGeneration/StaticNorth.Valiant.Settings.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/StaticNorth.Valiant.Settings.SourceGeneration/StaticNorth.Valiant.Settings.SourceGeneration.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../samples/StaticNorth.Valiant.Settings.AspNetCore.Samples/StaticNorth.Valiant.Settings.AspNetCore.Samples.csproj" />
    <ProjectReference Include="../../samples/StaticNorth.Valiant.Settings.Samples/StaticNorth.Valiant.Settings.Samples.csproj" />
    <ProjectReference Include="../../../validation/src/StaticNorth.Valiant.Validation/StaticNorth.Valiant.Validation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
