{
  "name": "valiant-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "clear": "docusaurus clear",
    "docs:current-major": "node scripts/current-major.js",
    "docs:import-major": "node scripts/docs-versions.js import",
    "docs:snapshot-major": "node scripts/docs-versions.js snapshot",
    "docs:validate-major": "node scripts/docs-versions.js validate",
    "docs:generate-llms": "node scripts/generate-llms.mjs --write",
    "docs:check-llms": "node scripts/generate-llms.mjs --check",
    "audit:dependencies": "node scripts/audit-dependencies.js",
    "test:docs-versions": "node --test scripts/*.test.js",
    "serve": "docusaurus serve",
    "docusaurus": "docusaurus"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2"
  },
  "overrides": {
    "brace-expansion": "1.1.18",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "serialize-javascript": "7.0.6"
  },
  "engines": {
    "node": ">=18.0"
  }
}
