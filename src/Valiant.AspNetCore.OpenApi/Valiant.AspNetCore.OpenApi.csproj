<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <PackageId>Valiant.AspNetCore.OpenApi</PackageId>
    <VersionPrefix>0.1.0-preview.1</VersionPrefix>
    <Authors>Valiant contributors</Authors>
    <Description>Native ASP.NET Core OpenAPI integration for Valiant validation metadata.</Description>
    <PackageTags>validation;aspnetcore;openapi;swagger</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/static-north-dev/valiant</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <ProjectReference Include="../Valiant/Valiant.csproj" />
  </ItemGroup>

</Project>
