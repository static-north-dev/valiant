<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <PackageId>Valiant</PackageId>
    <VersionPrefix>0.1.0-preview.1</VersionPrefix>
    <Authors>Valiant contributors</Authors>
    <Description>A source-generated, AOT-friendly validation library for .NET.</Description>
    <PackageTags>validation;source-generator;aot;nativeaot;dependency-injection</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/static-north-dev/valiant</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddValiantSourceGeneratorToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="../Valiant.SourceGeneration/Valiant.SourceGeneration.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>

  <Target Name="BuildValiantSourceGeneratorForPack" Condition="'$(NoBuild)' != 'true'">
    <MSBuild Projects="../Valiant.SourceGeneration/Valiant.SourceGeneration.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0" RemoveProperties="TargetFrameworks;RuntimeIdentifier;SelfContained" />
  </Target>

  <Target Name="AddValiantSourceGeneratorToPackage" DependsOnTargets="BuildValiantSourceGeneratorForPack" Condition="'$(TargetFramework)' == 'net8.0'">
    <ItemGroup>
      <TfmSpecificPackageFile Include="../Valiant.SourceGeneration/bin/$(Configuration)/netstandard2.0/Valiant.SourceGeneration.dll" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
