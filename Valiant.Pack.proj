<Project>
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <NoBuild Condition="'$(NoBuild)' == ''">false</NoBuild>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.1.0-preview.1</PackageVersion>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
    <AotRuntimeIdentifier Condition="'$(AotRuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</AotRuntimeIdentifier>
    <AotExecutableExtension Condition="$([System.String]::Copy('$(AotRuntimeIdentifier)').StartsWith('win'))">.exe</AotExecutableExtension>
  </PropertyGroup>

  <ItemGroup>
    <PackProject Include="validation/src/Valiant.Validation/Valiant.Validation.csproj" PackageId="Valiant.Validation" />
    <PackProject Include="validation/src/Valiant.Validation.AspNetCore/Valiant.Validation.AspNetCore.csproj" PackageId="Valiant.Validation.AspNetCore" />
    <PackProject Include="validation/src/Valiant.Validation.AspNetCore.OpenApi/Valiant.Validation.AspNetCore.OpenApi.csproj" PackageId="Valiant.Validation.AspNetCore.OpenApi" />
    <PackProject Include="validation/src/Valiant.Validation.MediatR/Valiant.Validation.MediatR.csproj" PackageId="Valiant.Validation.MediatR" />
    <PackProject Include="validation/src/Valiant.Validation.Mediator/Valiant.Validation.Mediator.csproj" PackageId="Valiant.Validation.Mediator" />
    <PackProject Include="mapping/src/Valiant.Mapping/Valiant.Mapping.csproj" PackageId="Valiant.Mapping" />
    <PackProject Include="endpoints/src/Valiant.Endpoints.AspNetCore/Valiant.Endpoints.AspNetCore.csproj" PackageId="Valiant.Endpoints.AspNetCore" />
    <PackProject Include="settings/src/Valiant.Settings/Valiant.Settings.csproj" PackageId="Valiant.Settings" />
    <PackProject Include="settings/src/Valiant.Settings.AspNetCore/Valiant.Settings.AspNetCore.csproj" PackageId="Valiant.Settings.AspNetCore" />
    <PackProject Include="settings/src/Valiant.Settings.Validation/Valiant.Settings.Validation.csproj" PackageId="Valiant.Settings.Validation" />

    <PackageConsumer Include="smoke/Valiant.Endpoints.PackageConsumer/Valiant.Endpoints.PackageConsumer.csproj" />
    <PackageConsumer Include="smoke/Valiant.Mapping.PackageConsumer/Valiant.Mapping.PackageConsumer.csproj" />
    <PackageConsumer Include="smoke/Valiant.Validation.AspNetCore.PackageConsumer/Valiant.Validation.AspNetCore.PackageConsumer.csproj" />
    <PackageConsumer Include="smoke/Valiant.Validation.OpenApi.PackageConsumer/Valiant.Validation.OpenApi.PackageConsumer.csproj" />
    <PackageConsumer Include="smoke/Valiant.Settings.AspNetCore.PackageConsumer/Valiant.Settings.AspNetCore.PackageConsumer.csproj" />
    <PackageConsumer Include="smoke/Valiant.Settings.Validation.PackageConsumer/Valiant.Settings.Validation.PackageConsumer.csproj" />
    <PackageConsumer Include="smoke/Valiant.Validation.MediatR.PackageConsumer/Valiant.Validation.MediatR.PackageConsumer.csproj" />
    <PackageConsumer Include="smoke/Valiant.Validation.Mediator.PackageConsumer/Valiant.Validation.Mediator.PackageConsumer.csproj" />
  </ItemGroup>

  <Target Name="Pack">
    <MSBuild
      Projects="@(PackProject)"
      Targets="Pack"
      BuildInParallel="false"
      Properties="Configuration=$(Configuration);NoBuild=$(NoBuild);PackageVersion=$(PackageVersion);PackageOutputPath=$(PackageOutputPath)" />
  </Target>

  <Target Name="VerifyPackageArtifacts" DependsOnTargets="Pack">
    <Exec Command="dotnet run --project &quot;smoke/Valiant.PackageVerifier/Valiant.PackageVerifier.csproj&quot; --configuration $(Configuration) -- &quot;$(PackageOutputPath)&quot; &quot;$(PackageVersion)&quot;" />
  </Target>

  <Target Name="VerifyPackageConsumers" DependsOnTargets="VerifyPackageArtifacts">
    <Exec
      Command="dotnet restore &quot;%(PackageConsumer.Identity)&quot; --configfile &quot;smoke/NuGet.Config&quot; --packages &quot;artifacts/nuget-packages&quot; --force-evaluate -p:ValiantPackageVersion=$(PackageVersion)" />
    <Exec
      Command="dotnet run --project &quot;%(PackageConsumer.Identity)&quot; --configuration $(Configuration) --no-restore -p:ValiantPackageVersion=$(PackageVersion)" />
  </Target>

  <Target Name="VerifyAotSmoke" DependsOnTargets="VerifyPackageArtifacts" Condition="'$(AotRuntimeIdentifier)' != ''">
    <Exec Command="dotnet publish &quot;smoke/Valiant.AotSmoke/Valiant.AotSmoke.csproj&quot; --configuration $(Configuration) --runtime $(AotRuntimeIdentifier) --self-contained true -p:ValiantPackageVersion=$(PackageVersion) -p:RestoreConfigFile=$(MSBuildThisFileDirectory)smoke/NuGet.Config -p:RestorePackagesPath=$(MSBuildThisFileDirectory)artifacts/nuget-packages -p:RestoreForce=true" />
    <Exec Command="smoke/Valiant.AotSmoke/bin/$(Configuration)/net10.0/$(AotRuntimeIdentifier)/publish/Valiant.AotSmoke$(AotExecutableExtension)" />
  </Target>
</Project>
