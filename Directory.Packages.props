<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- .NET 11 runtime support first shipped in the 0.16.0 preview line. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <!-- Intentionally pinned: MediatR 12.5.0 is the final free MediatR release. -->
    <PackageVersion Include="MediatR" Version="[12.5.0]" />
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.NET.ILLink.Tasks" Version="11.0.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="[2.7.5,3.0.0)" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.OpenApi" Version="[3.11.0,4.0.0)" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageVersion Include="TUnit" Version="1.84.0" />
    <PackageVersion Include="Validly" Version="1.3.0" />
    <PackageVersion Include="Validly.Extensions.Validators" Version="1.3.0" />
    <PackageVersion Include="Validly.SourceGenerator" Version="1.3.0" />
  </ItemGroup>
</Project>
