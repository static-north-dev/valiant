<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3050</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StaticNorth.Valiant.Mapping" Version="$(StaticNorthValiantPackageVersion)" />
    <PackageReference Include="StaticNorth.Valiant.Settings" Version="$(StaticNorthValiantPackageVersion)" />
    <PackageReference Include="StaticNorth.Valiant.Validation" Version="$(StaticNorthValiantPackageVersion)" />
    <PackageReference Include="StaticNorth.Valiant.Validation.AspNetCore" Version="$(StaticNorthValiantPackageVersion)" />
  </ItemGroup>
</Project>
