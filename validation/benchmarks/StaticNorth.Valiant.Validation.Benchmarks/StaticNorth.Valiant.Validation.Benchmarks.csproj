<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Features Condition="'$(ValiantBenchmarkRuntimeAsync)' == 'true'">$(Features);runtime-async=on</Features>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Validly" />
    <PackageReference Include="Validly.Extensions.Validators" />
    <PackageReference Include="Validly.SourceGenerator" PrivateAssets="all" />
    <ProjectReference Include="../../src/StaticNorth.Valiant.Validation/StaticNorth.Valiant.Validation.csproj" />
    <ProjectReference Include="../../src/StaticNorth.Valiant.Validation.AspNetCore/StaticNorth.Valiant.Validation.AspNetCore.csproj" />
    <ProjectReference Include="../../src/StaticNorth.Valiant.Validation.SourceGeneration/StaticNorth.Valiant.Validation.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
