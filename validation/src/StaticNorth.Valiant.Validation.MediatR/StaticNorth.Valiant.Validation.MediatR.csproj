<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>StaticNorth.Valiant.Validation.MediatR</PackageId>
    <Description>MediatR pipeline behavior integration for Valiant validation.</Description>
    <PackageTags>validation;mediatr;pipeline-behavior;cqrs</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <ProjectReference Include="..\StaticNorth.Valiant.Validation\StaticNorth.Valiant.Validation.csproj" PrivateAssets="contentfiles" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="contentFiles\**\*.cs" />
    <None Include="buildTransitive\StaticNorth.Valiant.Validation.MediatR.props" Pack="true" PackagePath="buildTransitive\StaticNorth.Valiant.Validation.MediatR.props" />
    <None Include="contentFiles\cs\any\ValiantMediatRExtensions.cs" Pack="true" PackagePath="contentFiles\cs\any\ValiantMediatRExtensions.cs" />
  </ItemGroup>

</Project>
