<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <UseTestingPlatformProtocol>true</UseTestingPlatformProtocol>
    <IsTestingPlatformEnabled>true</IsTestingPlatformEnabled>
    <NoWarn>$(NoWarn);VLT106</NoWarn>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v5pm-xwqc-g5wc" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Net.Compilers.Toolset" PrivateAssets="all" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../../shared/tests/Valiant.SourceGeneration.Testing/*.cs" LinkBase="Shared" />
    <ProjectReference Include="../../src/Valiant.Validation/Valiant.Validation.csproj" />
    <ProjectReference Include="../../src/Valiant.Validation.AspNetCore/Valiant.Validation.AspNetCore.csproj" />
    <ProjectReference Include="../../src/Valiant.Validation.AspNetCore.OpenApi/Valiant.Validation.AspNetCore.OpenApi.csproj" />
    <ProjectReference Include="../../src/Valiant.Validation.MediatR/Valiant.Validation.MediatR.csproj" />
    <ProjectReference Include="../../src/Valiant.Validation.Mediator/Valiant.Validation.Mediator.csproj" />
    <ProjectReference Include="../../src/Valiant.Validation.SourceGeneration/Valiant.Validation.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Valiant.Validation.SourceGeneration/Valiant.Validation.SourceGeneration.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../samples/Valiant.Validation.Samples/Valiant.Validation.Samples.csproj" />
    <ProjectReference Include="../../samples/Valiant.Validation.AspNetCore.Samples/Valiant.Validation.AspNetCore.Samples.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
